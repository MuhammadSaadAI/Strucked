# ============================================
# Struked LLC — Backend Environment Variables
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Server
PORT=5000

# Email Notifications (optional — SMTP configuration)
# Leave empty to disable email notifications.
# Works with Gmail, Outlook, SendGrid, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here

# Email address to receive new quote notifications
NOTIFY_EMAIL=info@struked.com

# Allowed CORS origin (set to your domain in production)
# Use * for development, restrict in production
ALLOWED_ORIGIN=*
